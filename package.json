{
  "name": "trailers-capacitacion-ia-generativa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tráilers cinematográficos estilo Apple Keynote para capacitación IA Generativa (UIFCE · UNAL). Sesión 01: Fundamentos.",
  "scripts": {
    "start": "remotion studio",
    "render:sesion01": "remotion render TrailerSesion01 out/sesion-01-fundamentos.mp4 --codec h264 --crf 18",
    "render:sesion01-webm": "remotion render TrailerSesion01 out/sesion-01-fundamentos.webm --codec vp9",
    "still:sesion01": "remotion still TrailerSesion01 out/still-01.png --frame 300",
    "still:3d": "remotion still TrailerSesion01 out/check3d-700.png --frame=700",
    "render:sesion02": "remotion render TrailerSesion02 out/sesion-02-practica-mcp.mp4 --codec h264 --crf 18",
    "still:sesion02": "remotion still TrailerSesion02 out/still-02.png --frame 300",
    "still:sesion02-robots": "remotion still TrailerSesion02 out/check02-robots.png --frame=700",
    "still:sesion02-db": "remotion still TrailerSesion02 out/check02-db.png --frame=1300",
    "still:sesion02-dc": "remotion still TrailerSesion02 out/check02-dc.png --frame=1900",
    "lint": "tsc --noEmit",
    "threejs:check": "tsc --noEmit && echo '[OK] 9 factories img2threejs compilan'"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.422",
    "@remotion/google-fonts": "^4.0.422",
    "@types/three": "^0.186.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.422",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/web": "^0.0.290",
    "typescript": "^5.9.3"
  }
}
